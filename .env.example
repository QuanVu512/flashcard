# Database (H2 file is used when these values are omitted).
# DATABASE_URL=jdbc:postgresql://your-neon-host.neon.tech/your-db?sslmode=require
# DATABASE_USERNAME=your-neon-user
# DATABASE_PASSWORD=your-neon-password

SERVER_PORT=8000
SPRING_PROFILES_ACTIVE=dev

# Authentication secrets. Use independent random values of at least 32 bytes.
# JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# JWT_BASE64_SECRET=base64-secret-containing-at-least-32-bytes
AUTH_OTP_HASH_SECRET=replace-with-a-different-random-secret-at-least-32-bytes

# Session lifetime: short access JWT plus a rotating, opaque refresh cookie.
AUTH_ACCESS_MINUTES=15
AUTH_PASSWORD_SESSION_DAYS=3
AUTH_GOOGLE_SESSION_DAYS=30
AUTH_TRUSTED_DEVICE_DAYS=30

# OTP policy.
AUTH_OTP_EXPIRATION_MINUTES=5
AUTH_OTP_INITIAL_RESEND_SECONDS=10
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_SENDS=5
AUTH_OTP_SEND_WINDOW_HOURS=6
AUTH_OTP_BROWSER_BLOCK_SECONDS=120
AUTH_REGISTRATION_CLEANUP_DELAY_MS=60000

# SMTP. Gmail requires 2-Step Verification and a 16-character App Password.
AUTH_MAIL_ENABLED=true
AUTH_MAIL_FROM=your-account@gmail.com
AUTH_MAIL_WORKER_DELAY_MS=500
AUTH_MAIL_WORKER_CONCURRENCY=2
AUTH_MAIL_DELIVERY_MAX_ATTEMPTS=3
AUTH_MAIL_PROCESSING_LEASE_SECONDS=60
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# Google OAuth 2.0 Web client.
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI={baseUrl}/login/oauth2/code/google
# APP_FRONTEND_BASE_URL=https://your-frontend.example.com

# Authentication cookies. Secure must be true behind production HTTPS.
# AUTH_COOKIE_NAME=flashcard_access_token
# AUTH_REFRESH_COOKIE_NAME=flashcard_refresh_token
# AUTH_TRUSTED_DEVICE_COOKIE_NAME=flashcard_trusted_device
# AUTH_GOOGLE_LINK_COOKIE_NAME=flashcard_google_link
# AUTH_OAUTH_RETURN_COOKIE_NAME=flashcard_oauth_return
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAME_SITE=Lax

# Security/rate limit.
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_API_CAPACITY=120
APP_RATE_LIMIT_WINDOW_SECONDS=60

# Optional bootstrap administrator.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-this-strong-password
# ADMIN_DISPLAY_NAME=Admin

# Optional separate frontend origin.
# APP_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Azure Translator (optional).
# TRANSLATION_PROVIDER=azure
# TRANSLATION_DEFAULT_TARGET=vi
# AZURE_TRANSLATOR_KEY=your-azure-translator-key
# AZURE_TRANSLATOR_REGION=global
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Azure Vision OCR (optional and separate from Translator).
# HANDWRITING_PROVIDER=azure
# AZURE_VISION_KEY=your-azure-vision-key
# AZURE_VISION_ENDPOINT=https://your-vision-resource.cognitiveservices.azure.com
